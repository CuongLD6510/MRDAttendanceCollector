    "MaxParallelJobs": 1,
    "JobTimeoutSeconds": 180,
    "RetryMaxAttempts": 3,
    "RetryDelaySeconds": 10,
    "DefaultOverlapMinutes": 30,
    "InitialSyncFromDate": "2026-01-01"
