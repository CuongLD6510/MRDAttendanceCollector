    "MaxItemsPerDrain": 25,
    "TimeoutSeconds": 300,
    "Enabled": true
  },
  "Backend": {
    "BaseUrl": "https://uat.mrd-mic.com/MRDTimeLeaveAPI",
    "ApiKey": "",
    "TimeoutSeconds": 90
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http": "Warning"
    }
  }
}
